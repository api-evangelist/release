            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App ID (integer or hashid)"
              }
            ]
          },
          "docs": "Get latest app config"
        },
        {
          "info": {
            "name": "Get latest env config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.release.com/apps/:app_id/latest_env_config",
