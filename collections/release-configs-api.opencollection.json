              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Environment ID (integer or hashid)"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource ID (integer or hashid)"
              }
            ]
          },
          "docs": "Get Serialized config"
        },
        {
          "info": {
            "name": "Get latest app config",
            "type": "http"
