{
  "opencollection": "1.0.0",
  "info": {
    "name": "Release.com Platform Accounts Remote Development API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-User-Email",
      "value": "{{X-User-Email}}",
      "placement": "header"
    }
  },
  "items": [
